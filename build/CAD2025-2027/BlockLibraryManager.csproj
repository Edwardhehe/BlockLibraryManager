<Project Sdk="Microsoft.NET.Sdk">

  <!-- AutoCAD 2025 / 2026 / 2027  =>  .NET 8.0 (windows) -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputFolderName>CAD2025-2027</OutputFolderName>
    <AssemblyTitle>图库管理器 (AutoCAD 2025-2027)</AssemblyTitle>
    <AcadRefDir Condition="'$(AcadRefDir)' == ''">C:\Program Files\Autodesk\AutoCAD 2026</AcadRefDir>
    <UseAccoreMgd>true</UseAccoreMgd>
    <DefineConstants>$(DefineConstants);ACAD_2013_OR_NEWER;ACAD_2015_OR_NEWER;ACAD2025_OR_NEWER;NETCORE</DefineConstants>
  </PropertyGroup>

  <Import Project="..\..\src\Common.props" />

</Project>
