<Project Sdk="Microsoft.NET.Sdk">

  <!-- AutoCAD 2019 / 2020 / 2021 / 2022 / 2023 / 2024  =>  .NET Framework 4.7 -->
  <PropertyGroup>
    <TargetFramework>net47</TargetFramework>
    <OutputFolderName>CAD2019-2024</OutputFolderName>
    <AssemblyTitle>图库管理器 (AutoCAD 2019-2024)</AssemblyTitle>
    <AcadRefDir Condition="'$(AcadRefDir)' == ''">C:\Program Files\Autodesk\AutoCAD 2024</AcadRefDir>
    <UseAccoreMgd>true</UseAccoreMgd>
    <DefineConstants>$(DefineConstants);ACAD_2013_OR_NEWER;ACAD_2015_OR_NEWER</DefineConstants>
  </PropertyGroup>

  <Import Project="..\..\src\Common.props" />

</Project>
