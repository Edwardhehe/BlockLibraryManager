<Project Sdk="Microsoft.NET.Sdk">

  <!-- AutoCAD 2010 / 2011  =>  .NET Framework 3.5 -->
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <OutputFolderName>CAD2010-2011</OutputFolderName>
    <AssemblyTitle>图库管理器 (AutoCAD 2010-2011)</AssemblyTitle>
    <AcadRefDir Condition="'$(AcadRefDir)' == ''">C:\Program Files\Autodesk\AutoCAD 2011</AcadRefDir>
    <UseAccoreMgd>false</UseAccoreMgd>
    <DefineConstants>$(DefineConstants);ACAD_2012_OR_OLDER</DefineConstants>
  </PropertyGroup>

  <Import Project="..\..\src\Common.props" />

</Project>
