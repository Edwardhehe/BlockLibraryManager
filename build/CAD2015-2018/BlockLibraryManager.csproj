<Project Sdk="Microsoft.NET.Sdk">

  <!-- AutoCAD 2015 / 2016 / 2017 / 2018  =>  .NET Framework 4.5 -->
  <PropertyGroup>
    <TargetFramework>net45</TargetFramework>
    <OutputFolderName>CAD2015-2018</OutputFolderName>
    <AssemblyTitle>图库管理器 (AutoCAD 2015-2018)</AssemblyTitle>
    <AcadRefDir Condition="'$(AcadRefDir)' == ''">C:\Program Files\Autodesk\AutoCAD 2018</AcadRefDir>
    <UseAccoreMgd>true</UseAccoreMgd>
    <DefineConstants>$(DefineConstants);ACAD_2013_OR_NEWER;ACAD_2015_OR_NEWER</DefineConstants>
  </PropertyGroup>

  <Import Project="..\..\src\Common.props" />

</Project>
