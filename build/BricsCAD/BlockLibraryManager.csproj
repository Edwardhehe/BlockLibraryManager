<Project Sdk="Microsoft.NET.Sdk">

  <!--
    BricsCAD 版本
      命名空间   **双根**（与中望 / 浩辰的单根替换不同）：
                    Autodesk.AutoCAD.ApplicationServices -> Bricscad.ApplicationServices
                    Autodesk.AutoCAD.EditorInput         -> Bricscad.EditorInput
                    Autodesk.AutoCAD.Windows             -> Bricscad.Windows
                    Autodesk.AutoCAD.Runtime             -> Teigha.Runtime
                    Autodesk.AutoCAD.DatabaseServices    -> Teigha.DatabaseServices
                    Autodesk.AutoCAD.Geometry            -> Teigha.Geometry
                  Bricscad.* 来自 BrxMgd.dll，Teigha.* 来自 TD_Mgd.dll（ODA DWG 内核）。
      托管程序集 BrxMgd.dll + TD_Mgd.dll（官方 NuGet：BricsCAD.27.NET / BricsCAD.26.NET）
      目标框架   .NET 8（BricsCAD V26 起宿主切换到 .NET 8；V25 及更早是 .NET Framework 4.8）
      已验证版本 BricsCAD V27（27.1.3 参考程序集）

    编译（默认用仓库内已下载好的官方参考程序集，本机无需安装 BricsCAD）：
      build-bricscad.cmd
      或手工：
      dotnet build build\BricsCAD\BlockLibraryManager.csproj -c Release

    想改成 BricsCAD V26 的参考程序集：
      dotnet build build\BricsCAD\BlockLibraryManager.csproj -c Release ^
              -p:CadRefDir="tools\bcapi\v26\ref\net8.0"

    想给 V25 及更早（.NET Framework 4.8 宿主）编译：
      dotnet build build\BricsCAD\BlockLibraryManager.csproj -c Release ^
              -p:TargetFramework=net48 ^
              -p:CadRefDir="C:\Program Files\Bricsys\BricsCAD V25"
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputFolderName>BricsCAD</OutputFolderName>
    <AssemblyTitle>图库管理器 (BricsCAD)</AssemblyTitle>
    <CadPlatform>BricsCAD</CadPlatform>
    <!-- 兜底命名空间根：只用于上面映射表没覆盖到的 Autodesk.AutoCAD.* -->
    <CadNamespace>Bricscad</CadNamespace>
    <CadRefDir Condition="'$(CadRefDir)' == ''">$(MSBuildThisFileDirectory)..\..\tools\bcapi\v27\ref\net8.0</CadRefDir>
    <CadRefItems>BrxMgd;TD_Mgd</CadRefItems>
    <CadFirstRef>BrxMgd</CadFirstRef>
    <DefineConstants>$(DefineConstants);BRICSCAD_COMPAT</DefineConstants>
    <!-- BrxMgd.dll 是 C++/CLI 混合程序集，内部引用了 WindowsBase 8.0.0.0（WPF）；
         .NET 8 的 Microsoft.NETCore.App 引用包里也带了一个同名 facade（4.0.0.0），
         MSBuild 因此报 MSB3277「版本冲突」。本项目完全不用 WPF，编译时选哪个
         facade 都不影响生成的 IL（产物里根本不会出现对 WindowsBase 的引用），
         运行期由 BricsCAD 宿主提供真正的 WindowsBase，所以这条警告可以安全忽略。
         只对 BricsCAD 这一个工程降级为"消息"，不放进共用的 Common.CadPlatform.props，
         免得把其它平台真正的引用冲突也一起藏起来。
         注意：MSB3277 是 MSBuild 的任务警告（不是 csc 的），所以要用
         MSBuildWarningsAsMessages，写 NoWarn 是压不住的。 -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <Import Project="..\..\src\Common.CadPlatform.props" />

</Project>
